+        );
+        shell.update(cx, |_, cx| cx.notify());
+        handle
+            .update(cx, |_, window, cx| {
+                window.draw(cx).clear(cx);
+                window.blur(cx);
+            })
+            .unwrap();
+        assert!(
+            handle
+                .update(cx, |_, window, cx| window.focused(cx))
+                .unwrap()
+                .is_none()
+        );
