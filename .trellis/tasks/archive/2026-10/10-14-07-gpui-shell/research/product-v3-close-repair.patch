+            .unwrap();
+        shell.read_with(cx, |shell, _| {
+            assert!(shell.presenter.is_none());
+            assert_eq!(
+                shell.import_token, 1,
+                "current user close takes the explicit quit branch"
+            );
+        });
+    }
