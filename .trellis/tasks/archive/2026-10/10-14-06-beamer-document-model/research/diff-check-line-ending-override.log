+
.trellis/spec/backend/logging-guidelines.md:7: trailing whitespace.
+```rust
.trellis/spec/backend/logging-guidelines.md:8: trailing whitespace.
+tracing_subscriber::fmt()
.trellis/spec/backend/logging-guidelines.md:9: trailing whitespace.
+    .with_env_filter(
.trellis/spec/backend/logging-guidelines.md:10: trailing whitespace.
+        tracing_subscriber::EnvFilter::try_from_default_env()
.trellis/spec/backend/logging-guidelines.md:11: trailing whitespace.
+            .unwrap_or_else(|_| tracing_subscriber::EnvFilter::new("info")),
.trellis/spec/backend/logging-guidelines.md:12: trailing whitespace.
